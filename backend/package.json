{
  "name": "ielts-practice-backend",
  "version": "1.0.0",
  "description": "Backend API for IELTS Practice Application with pronunciation analysis",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "setup:python": "pip3 install -r requirements.txt",
    "postinstall": "echo 'Run npm run setup:python to install Python dependencies for IPA conversion'"
  },
  "keywords": [
    "ielts",
    "pronunciation",
    "speech-analysis",
    "azure-speech",
    "express",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.2.0",
    "assemblyai": "^4.4.5",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.10.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
