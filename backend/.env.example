# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Azure Speech Service Configuration (Required for pronunciation analysis)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=

# AssemblyAI Configuration (Required for speech-to-text transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# OpenAI Configuration (Required for transcript enhancement)
OPENAI_API_KEY=your_openai_api_key_here

# Google Text-to-Speech Configuration (Required for audio questions)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# LiveKit Configuration (Optional)
LIVEKIT_URL=your_livekit_url_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# External API Configuration
SUBMISSION_API_URL=https://classconnect-staging-107872842385.us-west2.run.app/api/v1/submission/submit

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=combined

# Upload Configuration
MAX_FILE_SIZE=50mb