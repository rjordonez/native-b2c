# Frontend Environment Variables
# For local development: http://localhost:3001
# For production: https://your-backend-domain.com
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostHog Configuration
VITE_POSTHOG_KEY=your_posthog_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# LiveKit Configuration (Server-side only - DO NOT expose to client)
LIVEKIT_URL=your_livekit_url_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Backend Environment Variables (for Vercel deployment)
# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# AssemblyAI
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# OpenAI (for transcript enhancement)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
NODE_ENV=production
PORT=3001
ALLOWED_ORIGINS=https://your-app.vercel.app

# Google Cloud TTS (if using)
GOOGLE_APPLICATION_CREDENTIALS_JSON=your_google_service_account_json_here

# Optional: App Configuration
VITE_APP_CONFIG_ENDPOINT=""
VITE_SANDBOX_ID=""
VITE_CONN_DETAILS_ENDPOINT=/api/connection-details